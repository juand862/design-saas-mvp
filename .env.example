# Canvas SaaS — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.

# --- Anthropic (pipeline de agentes) ----------------------------------------
# Requerido en Fase 2A. Sin esta key las rutas /api/agents/* devuelven 500.
# Se obtiene en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Replicate (generación de imágenes, Fase 2B) ----------------------------
# Opcional hasta Fase 2B. Lo necesita el Image Generation agent.
# REPLICATE_API_TOKEN=
